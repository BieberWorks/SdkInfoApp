@page "/graph"
@inject SnapshotService SnapshotService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Module Graph</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Module Dependency Graph</MudText>

@if (!SnapshotService.IsLoaded)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

@if (SnapshotService.Snapshot is null)
{
    <MudAlert Severity="Severity.Warning">No snapshot loaded.</MudAlert>
    return;
}

<MudPaper Class="pa-2 mb-3" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="3">
            <MudSelect T="int?" Label="Filter by Tier" Value="_tierFilter" ValueChanged="OnTierFilterChanged" Clearable="true">
                @foreach (var tier in _availableTiers)
                {
                    <MudSelectItem T="int?" Value="@((int?)tier)">Tier @tier</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="string" Label="Arrangement" Value="_layoutMode" ValueChanged="OnLayoutModeChanged">
                <MudSelectItem T="string" Value="@("dagre")">Hierarchical</MudSelectItem>
                <MudSelectItem T="string" Value="@("dagre-lr")">Hierarchical L→R</MudSelectItem>
                <MudSelectItem T="string" Value="@("breadthfirst")">Tree (Breadthfirst)</MudSelectItem>
                <MudSelectItem T="string" Value="@("cose")">Force-directed</MudSelectItem>
                <MudSelectItem T="string" Value="@("concentric-tier")">Concentric by Tier</MudSelectItem>
                <MudSelectItem T="string" Value="@("grid-tier")">Grid by Tier</MudSelectItem>
                <MudSelectItem T="string" Value="@("grid-release")">Grid by Release Order</MudSelectItem>
                <MudSelectItem T="string" Value="@("grid-module")">Grid by Module</MudSelectItem>
                <MudSelectItem T="string" Value="@("grid-name")">Grid A–Z</MudSelectItem>
                <MudSelectItem T="string" Value="@("grid-dependents")">Grid by Dependents</MudSelectItem>
                <MudSelectItem T="string" Value="@("circle")">Circle</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudText Typo="Typo.caption" Class="mb-1">Click direction</MudText>
            <div class="d-flex flex-wrap align-center gap-2">
                <MudToggleGroup T="string" Value="_clickDirection" ValueChanged="OnClickDirectionChanged"
                                SelectionMode="SelectionMode.SingleSelection"
                                Size="Size.Small" Outlined="true" Dense="true">
                    <MudToggleItem Value="@("both")">Both</MudToggleItem>
                    <MudToggleItem Value="@("depends")">Depends on</MudToggleItem>
                    <MudToggleItem Value="@("used")">Used by</MudToggleItem>
                </MudToggleGroup>
                <MudSwitch T="bool" Value="_clickTransitive" ValueChanged="OnClickTransitiveChanged"
                           Label="Transitive" Size="Size.Small" Color="Color.Primary" />
            </div>
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center gap-1 flex-wrap">
            <MudIconButton Icon="@Icons.Material.Filled.Save" Title="Save Layout"
                           OnClick="SaveLayout" Size="Size.Small" />
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ResetFilters">Reset</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.GridView" OnClick="ResetLayout">Layout</MudButton>
        </MudItem>
    </MudGrid>
    <MudGrid Spacing="2" Class="mt-1">
        <MudItem xs="12" sm="5">
            <MudSlider T="double" Min="0.0" Max="0.5" Step="0.05"
                       Value="_dimOpacity" ValueChanged="OnDimOpacityChanged"
                       Color="Color.Secondary">
                Dimmed opacity: @(_dimOpacity.ToString("F2"))
            </MudSlider>
        </MudItem>
        @if (_presentEdgeKinds.Length > 1)
        {
            <MudItem xs="12" sm="7">
                <MudText Typo="Typo.caption" Class="mb-1">Show edge kinds</MudText>
                <MudToggleGroup T="string" SelectionMode="SelectionMode.MultiSelection"
                                Values="_visibleEdgeKinds" ValuesChanged="OnEdgeKindsChanged"
                                Size="Size.Small" Outlined="true" Dense="true">
                    @foreach (var kind in _presentEdgeKinds)
                    {
                        <MudToggleItem T="string" Value="@kind">@EdgeKindLabel(kind)</MudToggleItem>
                    }
                </MudToggleGroup>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

<div style="position:relative;">
    <CytoscapeGraph @ref="_graph" Nodes="@_nodes" Edges="@_edges" Height="650px"
                    PersistKey="modules" Layout="@_layoutMode" ExportFileName="sdk-module-graph.png"
                    OnNodeClicked="OnNodeClicked" OnBackgroundTapped="OnBackgroundTapped" />

    @if (_selectedModule is not null)
    {
        <MudPaper Class="pa-4" Elevation="4"
                  Style="position:absolute; top:8px; right:8px; width:340px; max-height:calc(100% - 16px); overflow:auto; z-index:5;">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.h6">@_selectedModule.Id</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseDetail" />
            </div>
            <div class="d-flex flex-wrap gap-1 mb-2">
                @if (_selectedModule.ReleaseOrder.HasValue)
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">Dep-Tier T@(_selectedModule.Tier) · Release @_selectedModule.ReleaseOrder</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">Tier @_selectedModule.Tier</MudChip>
                }
                <CiStatusChip Status="@_selectedModule.CiStatus" />
            </div>
            <VersionBadge GhVersion="@_selectedModule.LatestGhVersion"
                          LocalDevVersion="@_selectedModule.LocalDevVersion"
                          ShowLocalDev="@SnapshotService.IsLocalMode" />
            @if (!string.IsNullOrEmpty(_selectedModule.Description))
            {
                <MudText Typo="Typo.body2" Class="mt-2">@_selectedModule.Description</MudText>
            }
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.subtitle2">Packages</MudText>
            @foreach (var pkg in _selectedModule.Packages)
            {
                <MudText Typo="Typo.caption" Style="font-family: monospace; display:block;">@pkg</MudText>
            }
            <MudDivider Class="my-2" />
            @{
                var transFrom = SnapshotService.GetTransitiveDependsOn(_selectedModule.Id);
                var transTo = SnapshotService.GetTransitiveUsedBy(_selectedModule.Id);
            }
            @if (transFrom.Count > 0 || transTo.Count > 0)
            {
                <MudSwitch T="bool" Value="_showTransitive" ValueChanged="@(v => _showTransitive = v)"
                           Color="Color.Primary" Size="Size.Small" Class="mb-1"
                           Label="@($"Show transitive (+{transFrom.Count + transTo.Count})")" />
            }
            <MudText Typo="Typo.subtitle2">Depends on</MudText>
            @foreach (var edge in SnapshotService.GetEdgesFrom(_selectedModule.Id))
            {
                <MudText Typo="Typo.caption">→ @edge.To (@edge.Kind)</MudText><br />
            }
            @if (_showTransitive)
            {
                @foreach (var id in transFrom)
                {
                    <MudText Typo="Typo.caption" Style="opacity:0.7;">⤳ @id (transitive)</MudText><br />
                }
            }
            <MudText Typo="Typo.subtitle2" Class="mt-1">Used by</MudText>
            @foreach (var edge in SnapshotService.GetEdgesTo(_selectedModule.Id))
            {
                <MudText Typo="Typo.caption">← @edge.From (@edge.Kind)</MudText><br />
            }
            @if (_showTransitive)
            {
                @foreach (var id in transTo)
                {
                    <MudText Typo="Typo.caption" Style="opacity:0.7;">⤙ @id (transitive)</MudText><br />
                }
            }
            <MudButton Class="mt-3" Variant="Variant.Outlined" Size="Size.Small"
                       OnClick="NavigateToDetail">
                Full Details
            </MudButton>
        </MudPaper>
    }
</div>

@code {
    private const string DimOpacityKey = "sdkinfo.graph.dimOpacity";

    private CytoscapeGraph? _graph;

    private List<ModuleInfo> _allModules = [];
    private List<CyNode> _nodes = [];
    private List<CyEdge> _edges = [];
    private int[] _availableTiers = [];
    private int? _tierFilter;
    private ModuleInfo? _selectedModule;
    private string _clickDirection = "both";
    private bool _clickTransitive;
    private double _dimOpacity = 0.25;
    private string _layoutMode = "dagre";
    private string[] _presentEdgeKinds = [];
    private IEnumerable<string> _visibleEdgeKinds = [];
    private bool _showTransitive;

    protected override async Task OnInitializedAsync()
    {
        await SnapshotService.LoadAsync();
        _allModules = [.. SnapshotService.GetModulesSortedByTier()];
        _availableTiers = _allModules.Select(m => m.Tier).Distinct().Order().ToArray();

        _presentEdgeKinds = [.. (SnapshotService.Snapshot?.Edges ?? [])
            .Select(e => e.Kind)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(EdgeKindSortOrder)];
        _visibleEdgeKinds = [.. _presentEdgeKinds];

        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", DimOpacityKey);
            _dimOpacity = double.TryParse(raw, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var v)
                ? Math.Clamp(v, 0.0, 0.5) : 0.25;

            var savedLayout = await JS.InvokeAsync<string?>("localStorage.getItem", "sdkinfo.graph.layout.modules");
            if (!string.IsNullOrEmpty(savedLayout))
                _layoutMode = savedLayout;
        }
        catch { /* JS not yet available — keep defaults */ }

        RebuildGraph();
    }

    private void RebuildGraph()
    {
        var snapshot = SnapshotService.Snapshot;
        if (snapshot is null) return;

        var visibleModuleIds = _allModules
            .Where(m => _tierFilter is null || m.Tier == _tierFilter)
            .Select(m => m.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        _nodes = _allModules
            .Where(m => visibleModuleIds.Contains(m.Id))
            .Select(m => new CyNode
            {
                Id = m.Id,
                Label = m.Id.Replace("SDK-", ""),
                Tier = m.Tier,
                CiStatus = m.CiStatus,
                HasLocalDev = m.LocalDevPresent,
                Group = m.Id,
                ReleaseOrder = m.ReleaseOrder,
            })
            .ToList();

        var visibleIds = _nodes.Select(n => n.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);

        _edges = snapshot.Edges
            .Where(e => visibleIds.Contains(e.From) && visibleIds.Contains(e.To))
            .Select(e => new CyEdge { Source = e.From, Target = e.To, Kind = e.Kind })
            .ToList();
    }

    private void OnNodeClicked(string nodeId)
    {
        _selectedModule = SnapshotService.GetModule(nodeId);
        StateHasChanged();
    }

    private async Task OnBackgroundTapped()
    {
        _selectedModule = null;
        if (_graph is not null)
            await _graph.ClearHighlightAsync();
        StateHasChanged();
    }

    private void CloseDetail()
    {
        _selectedModule = null;
        StateHasChanged();
    }

    private void NavigateToDetail()
    {
        if (_selectedModule is not null)
            Nav.NavigateTo($"modules/{_selectedModule.Id}");
    }

    private void OnTierFilterChanged(int? value)
    {
        _tierFilter = value;
        RebuildGraph();
    }

    private async Task OnLayoutModeChanged(string value)
    {
        _layoutMode = value;
        if (_graph is not null)
            await _graph.ApplyLayoutAsync(value);
    }

    private async Task OnClickDirectionChanged(string value)
    {
        _clickDirection = value;
        if (_graph is not null)
            await _graph.SetClickModeAsync(_clickDirection, _clickTransitive);
    }

    private async Task OnClickTransitiveChanged(bool value)
    {
        _clickTransitive = value;
        if (_graph is not null)
            await _graph.SetClickModeAsync(_clickDirection, _clickTransitive);
    }

    private async Task OnDimOpacityChanged(double value)
    {
        _dimOpacity = value;
        if (_graph is not null)
            await _graph.SetDimOpacityAsync(value);
    }

    private async Task OnEdgeKindsChanged(IEnumerable<string> values)
    {
        _visibleEdgeKinds = [.. values];
        if (_graph is not null)
            await _graph.SetEdgeKindFilterAsync([.. _visibleEdgeKinds]);
    }

    private static string EdgeKindLabel(string kind) => kind switch
    {
        "impl" => "Impl",
        "project" => "Project",
        "contracts" => "Contracts",
        "dangling" => "Dangling",
        _ => kind,
    };

    private static int EdgeKindSortOrder(string kind) => kind switch
    {
        "impl" => 0,
        "project" => 1,
        "contracts" => 2,
        "dangling" => 3,
        _ => 99,
    };

    private async Task SaveLayout()
    {
        if (_graph is not null)
            await _graph.SaveLayoutAsync();
    }

    private async Task ResetLayout()
    {
        if (_graph is not null)
            await _graph.ResetLayoutAsync();
    }

    private async Task ResetFilters()
    {
        _tierFilter = null;
        _selectedModule = null;
        _clickDirection = "both";
        _clickTransitive = false;
        _visibleEdgeKinds = [.. _presentEdgeKinds];
        RebuildGraph();
        if (_graph is not null)
        {
            await _graph.ClearHighlightAsync();
            await _graph.SetClickModeAsync(_clickDirection, _clickTransitive);
            await _graph.SetEdgeKindFilterAsync(null);
        }
    }
}
