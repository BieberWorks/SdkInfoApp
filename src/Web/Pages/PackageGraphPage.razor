@page "/packages"
@inject SnapshotService SnapshotService
@inject IJSRuntime JS

<PageTitle>Package Graph</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Package Dependency Graph</MudText>

@if (!SnapshotService.IsLoaded)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

@if (SnapshotService.Snapshot is null || SnapshotService.Snapshot.PackageNodes.Count == 0)
{
    <MudAlert Severity="Severity.Warning">
        No package data in snapshot. Re-run Scanner to generate it.
    </MudAlert>
    return;
}

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudText Typo="Typo.subtitle2" Class="mb-1">Highlight by module</MudText>
    <div class="d-flex flex-wrap gap-1 mb-2">
        @foreach (var m in _moduleEntries)
        {
            var isActive = _activeModules.Contains(m.Name);
            var bgColor = isActive ? TierColor(m.Tier) : "transparent";
            var textColor = isActive ? "#fff" : TierColor(m.Tier);
            var border = $"1.5px solid {TierColor(m.Tier)}";
            var opacity = isActive ? "1" : "0.55";
            <MudChip T="string"
                     Style="@($"background-color:{bgColor};color:{textColor};border:{border};opacity:{opacity};cursor:pointer;")"
                     Size="Size.Small"
                     OnClick="@(() => ToggleModule(m.Name))">
                @if (isActive)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" />
                }
                @m.Name
            </MudChip>
        }
    </div>

    <MudDivider Class="my-2" />

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudSelect T="string?" Label="Highlight dependents of" Value="_focusPackage"
                       ValueChanged="OnFocusPackageChanged" Clearable="true">
                @foreach (var p in _allPackageNodes)
                {
                    <MudSelectItem T="string?" Value="@p.Id">@ShortLabel(p.Id)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudText Typo="Typo.caption" Class="mb-1">Click direction</MudText>
            <div class="d-flex flex-wrap align-center gap-2">
                <MudToggleGroup T="string" Value="_clickDirection" ValueChanged="OnClickDirectionChanged"
                                SelectionMode="SelectionMode.SingleSelection"
                                Size="Size.Small" Outlined="true" Dense="true">
                    <MudToggleItem Value="@("both")">Both</MudToggleItem>
                    <MudToggleItem Value="@("depends")">Depends on</MudToggleItem>
                    <MudToggleItem Value="@("used")">Used by</MudToggleItem>
                </MudToggleGroup>
                <MudSwitch T="bool" Value="_clickTransitive" ValueChanged="OnClickTransitiveChanged"
                           Label="Transitive" Size="Size.Small" Color="Color.Primary" />
            </div>
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Outlined" OnClick="ResetFilters">Reset</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.GridView"
                       OnClick="ResetLayout">Reset Layout</MudButton>
        </MudItem>
    </MudGrid>
    <MudGrid Spacing="2" Class="mt-1">
        <MudItem xs="12" sm="5">
            <MudSlider T="double" Min="0.0" Max="0.5" Step="0.05"
                       Value="_dimOpacity" ValueChanged="OnDimOpacityChanged"
                       Color="Color.Secondary">
                Dimmed opacity: @(_dimOpacity.ToString("F2"))
            </MudSlider>
        </MudItem>
    </MudGrid>
</MudPaper>

<div style="position:relative;">
    <CytoscapeGraph @ref="_graph" Nodes="@_nodes" Edges="@_edges" Height="650px"
                    PersistKey="packages" Layout="cose"
                    OnNodeClicked="OnNodeClicked" OnBackgroundTapped="OnBackgroundTapped" />

    @if (_selectedPackage is not null)
    {
        <MudPaper Class="pa-4" Elevation="4"
                  Style="position:absolute; top:8px; right:8px; width:360px; max-height:calc(100% - 16px); overflow:auto; z-index:5;">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.subtitle1" Style="word-break:break-all;">@_selectedPackage.Id</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseDetail" />
            </div>
            <div class="d-flex align-center gap-1 mb-2">
                <MudChip T="string" Color="Color.Secondary" Size="Size.Small">@_selectedPackage.Module</MudChip>
                <MudChip T="string" Color="Color.Primary" Size="Size.Small">Tier @_selectedPackage.Tier</MudChip>
            </div>
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.subtitle2">Depends on</MudText>
            @foreach (var edge in SnapshotService.GetPackageEdgesFrom(_selectedPackage.Id))
            {
                <MudText Typo="Typo.caption">→ @ShortLabel(edge.To) (@edge.Kind)</MudText><br />
            }
            <MudText Typo="Typo.subtitle2" Class="mt-1">Used by</MudText>
            @foreach (var edge in SnapshotService.GetPackageEdgesTo(_selectedPackage.Id))
            {
                <MudText Typo="Typo.caption">← @ShortLabel(edge.From) (@edge.Kind)</MudText><br />
            }
        </MudPaper>
    }
</div>

@code {
    private const string DimOpacityKey = "sdkinfo.graph.dimOpacity";
    private record ModuleEntry(string Name, int Tier);

    private CytoscapeGraph? _graph;

    private List<PackageNode> _allPackageNodes = [];
    private List<ModuleEntry> _moduleEntries = [];
    private List<CyNode> _nodes = [];
    private List<CyEdge> _edges = [];
    private HashSet<string> _activeModules = new(StringComparer.OrdinalIgnoreCase);
    private string? _focusPackage;
    private PackageNode? _selectedPackage;
    private string _clickDirection = "both";
    private bool _clickTransitive;
    private double _dimOpacity = 0.25;

    protected override async Task OnInitializedAsync()
    {
        await SnapshotService.LoadAsync();
        _allPackageNodes = [.. SnapshotService.GetPackageNodesSortedByTier()];

        _moduleEntries = _allPackageNodes
            .GroupBy(p => p.Module)
            .Select(g => new ModuleEntry(g.Key, g.Min(p => p.Tier)))
            .OrderBy(m => m.Tier).ThenBy(m => m.Name)
            .ToList();

        // Read persisted dim opacity
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", DimOpacityKey);
            if (stored is not null && double.TryParse(stored, out var parsed))
                _dimOpacity = parsed;
        }
        catch { /* JS not yet available — keep default */ }

        RebuildGraph();
    }

    private void RebuildGraph()
    {
        var snapshot = SnapshotService.Snapshot;
        if (snapshot is null) return;

        _nodes = _allPackageNodes
            .Select(p => new CyNode
            {
                Id = p.Id,
                Label = ShortLabel(p.Id),
                Tier = p.Tier,
                CiStatus = null,
                HasLocalDev = false,
            })
            .ToList();

        var allIds = _nodes.Select(n => n.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);

        _edges = snapshot.PackageEdges
            .Where(e => allIds.Contains(e.From) && allIds.Contains(e.To))
            .Select(e => new CyEdge { Source = e.From, Target = e.To, Kind = e.Kind })
            .ToList();
    }

    private async Task ToggleModule(string moduleName)
    {
        if (!_activeModules.Add(moduleName))
            _activeModules.Remove(moduleName);

        _focusPackage = null;
        await ApplyModuleHighlight();
    }

    private async Task ApplyModuleHighlight()
    {
        if (_graph is null) return;

        if (_activeModules.Count == 0)
        {
            await _graph.ClearHighlightAsync();
            return;
        }

        var ids = _allPackageNodes
            .Where(p => _activeModules.Contains(p.Module))
            .Select(p => p.Id)
            .ToList();

        await _graph.HighlightAsync(ids);
    }

    private async Task OnFocusPackageChanged(string? value)
    {
        _focusPackage = value;
        _activeModules.Clear();

        if (_graph is null) return;

        if (string.IsNullOrEmpty(value))
        {
            await _graph.ClearHighlightAsync();
            return;
        }

        var dependents = GetDependents(value, SnapshotService.Snapshot!.PackageEdges).ToList();
        await _graph.HighlightAsync(dependents);
    }

    private async Task OnClickDirectionChanged(string value)
    {
        _clickDirection = value;
        if (_graph is not null)
            await _graph.SetClickModeAsync(_clickDirection, _clickTransitive);
    }

    private async Task OnClickTransitiveChanged(bool value)
    {
        _clickTransitive = value;
        if (_graph is not null)
            await _graph.SetClickModeAsync(_clickDirection, _clickTransitive);
    }

    private async Task OnDimOpacityChanged(double value)
    {
        _dimOpacity = value;
        if (_graph is not null)
            await _graph.SetDimOpacityAsync(value);
    }

    private static HashSet<string> GetDependents(string packageId, IReadOnlyList<PackageEdge> edges)
    {
        var result = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { packageId };
        bool changed = true;
        while (changed)
        {
            changed = false;
            foreach (var e in edges)
                if (result.Contains(e.To) && result.Add(e.From))
                    changed = true;
        }
        return result;
    }

    private static string ShortLabel(string packageId)
        => packageId.StartsWith("BieberWorks.SDK.", StringComparison.OrdinalIgnoreCase)
            ? packageId["BieberWorks.SDK.".Length..]
            : packageId;

    private static string TierColor(int tier) => tier switch
    {
        0 => "#4caf50",
        1 => "#2196f3",
        2 => "#9c27b0",
        3 => "#ff9800",
        4 => "#f44336",
        _ => "#795548",
    };

    private void OnNodeClicked(string nodeId)
    {
        _selectedPackage = SnapshotService.GetPackageNode(nodeId);
        StateHasChanged();
    }

    private async Task OnBackgroundTapped()
    {
        _selectedPackage = null;
        _focusPackage = null;
        _activeModules.Clear();
        if (_graph is not null)
            await _graph.ClearHighlightAsync();
        StateHasChanged();
    }

    private void CloseDetail()
    {
        _selectedPackage = null;
        StateHasChanged();
    }

    private async Task ResetFilters()
    {
        _activeModules.Clear();
        _focusPackage = null;
        _selectedPackage = null;
        _clickDirection = "both";
        _clickTransitive = false;
        if (_graph is not null)
        {
            await _graph.ClearHighlightAsync();
            await _graph.SetClickModeAsync(_clickDirection, _clickTransitive);
        }
    }

    private async Task ResetLayout()
    {
        if (_graph is not null)
            await _graph.ResetLayoutAsync();
    }
}
