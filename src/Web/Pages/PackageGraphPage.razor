@page "/packages"
@inject SnapshotService SnapshotService
@inject IJSRuntime JS

<PageTitle>Package Graph</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Package Dependency Graph</MudText>

@if (!SnapshotService.IsLoaded)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

@if (SnapshotService.Snapshot is null || SnapshotService.Snapshot.PackageNodes.Count == 0)
{
    <MudAlert Severity="Severity.Warning">
        No package data in snapshot. Re-run Scanner to generate it.
    </MudAlert>
    return;
}

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudText Typo="Typo.subtitle2" Class="mb-1">Highlight by module (chips = base)</MudText>
    <div class="d-flex flex-wrap gap-1 mb-2">
        @foreach (var m in _moduleEntries)
        {
            var isActive = _activeModules.Contains(m.Name);
            var bgColor = isActive ? TierColor(m.Tier) : "transparent";
            var textColor = isActive ? "#fff" : TierColor(m.Tier);
            var border = $"1.5px solid {TierColor(m.Tier)}";
            var opacity = isActive ? "1" : "0.55";
            <MudChip T="string"
                     Style="@($"background-color:{bgColor};color:{textColor};border:{border};opacity:{opacity};cursor:pointer;")"
                     Size="Size.Small"
                     OnClick="@(() => ToggleModule(m.Name))">
                @if (isActive)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" />
                }
                @m.Name
            </MudChip>
        }
    </div>

    <MudDivider Class="my-2" />

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="3">
            <MudSelect T="string" Label="Arrangement" Value="_layoutMode" ValueChanged="OnLayoutModeChanged">
                <MudSelectItem T="string" Value="@("dagre")">Hierarchical</MudSelectItem>
                <MudSelectItem T="string" Value="@("dagre-lr")">Hierarchical L→R</MudSelectItem>
                <MudSelectItem T="string" Value="@("breadthfirst")">Tree (Breadthfirst)</MudSelectItem>
                <MudSelectItem T="string" Value="@("cose")">Force-directed</MudSelectItem>
                <MudSelectItem T="string" Value="@("concentric-tier")">Concentric by Tier</MudSelectItem>
                <MudSelectItem T="string" Value="@("grid-tier")">Grid by Tier</MudSelectItem>
                <MudSelectItem T="string" Value="@("grid-release")">Grid by Release Order</MudSelectItem>
                <MudSelectItem T="string" Value="@("grid-module")">Grid by Module</MudSelectItem>
                <MudSelectItem T="string" Value="@("grid-name")">Grid A–Z</MudSelectItem>
                <MudSelectItem T="string" Value="@("grid-dependents")">Grid by Dependents</MudSelectItem>
                <MudSelectItem T="string" Value="@("circle")">Circle</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="string" Label="Click combine" Value="_combineMode" ValueChanged="OnCombineModeChanged">
                <MudSelectItem T="string" Value="@("base")">Chips as base</MudSelectItem>
                <MudSelectItem T="string" Value="@("union")">Union</MudSelectItem>
                <MudSelectItem T="string" Value="@("intersection")">Intersection</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudText Typo="Typo.caption" Class="mb-1">Click direction</MudText>
            <div class="d-flex flex-wrap align-center gap-2">
                <MudToggleGroup T="string" Value="_clickDirection" ValueChanged="OnClickDirectionChanged"
                                SelectionMode="SelectionMode.SingleSelection"
                                Size="Size.Small" Outlined="true" Dense="true">
                    <MudToggleItem Value="@("both")">Both</MudToggleItem>
                    <MudToggleItem Value="@("depends")">Depends on</MudToggleItem>
                    <MudToggleItem Value="@("used")">Used by</MudToggleItem>
                </MudToggleGroup>
                <MudSwitch T="bool" Value="_clickTransitive" ValueChanged="OnClickTransitiveChanged"
                           Label="Transitive" Size="Size.Small" Color="Color.Primary" />
            </div>
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center gap-1 flex-wrap">
            <MudIconButton Icon="@Icons.Material.Filled.Save" Title="Save Layout"
                           OnClick="SaveLayout" Size="Size.Small" />
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ResetFilters">Reset</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.GridView" OnClick="ResetLayout">Layout</MudButton>
        </MudItem>
    </MudGrid>
    <MudGrid Spacing="2" Class="mt-1">
        <MudItem xs="12" sm="5">
            <MudSlider T="double" Min="0.0" Max="0.5" Step="0.05"
                       Value="_dimOpacity" ValueChanged="OnDimOpacityChanged"
                       Color="Color.Secondary">
                Dimmed opacity: @(_dimOpacity.ToString("F2"))
            </MudSlider>
        </MudItem>
        @if (_presentEdgeKinds.Length > 1)
        {
            <MudItem xs="12" sm="7">
                <MudText Typo="Typo.caption" Class="mb-1">Show edge kinds</MudText>
                <MudToggleGroup T="string" SelectionMode="SelectionMode.MultiSelection"
                                Values="_visibleEdgeKinds" ValuesChanged="OnEdgeKindsChanged"
                                Size="Size.Small" Outlined="true" Dense="true">
                    @foreach (var kind in _presentEdgeKinds)
                    {
                        <MudToggleItem T="string" Value="@kind">@EdgeKindLabel(kind)</MudToggleItem>
                    }
                </MudToggleGroup>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

<div style="position:relative;">
    <CytoscapeGraph @ref="_graph" Nodes="@_nodes" Edges="@_edges" Height="650px"
                    PersistKey="packages" Layout="@_layoutMode" ExportFileName="sdk-package-graph.png"
                    OnNodeClicked="OnNodeClicked" OnBackgroundTapped="OnBackgroundTapped" />

    @if (_selectedPackage is not null)
    {
        <MudPaper Class="pa-4" Elevation="4"
                  Style="position:absolute; top:8px; right:8px; width:360px; max-height:calc(100% - 16px); overflow:auto; z-index:5;">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.subtitle1" Style="word-break:break-all;">@_selectedPackage.Id</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseDetail" />
            </div>
            <div class="d-flex align-center gap-1 mb-2">
                <MudChip T="string" Color="Color.Secondary" Size="Size.Small">@_selectedPackage.Module</MudChip>
                @{
                    var selMod = SnapshotService.GetModule(_selectedPackage.Module);
                }
                @if (selMod?.ReleaseOrder.HasValue == true)
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">Dep-Tier T@(_selectedPackage.Tier) · Release @selMod.ReleaseOrder</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">Tier @_selectedPackage.Tier</MudChip>
                }
            </div>
            <MudDivider Class="my-2" />
            @{
                var pkgTransFrom = SnapshotService.GetTransitivePackageDependsOn(_selectedPackage.Id);
                var pkgTransTo = SnapshotService.GetTransitivePackageUsedBy(_selectedPackage.Id);
            }
            @if (pkgTransFrom.Count > 0 || pkgTransTo.Count > 0)
            {
                <MudSwitch T="bool" Value="_showTransitive" ValueChanged="@(v => _showTransitive = v)"
                           Color="Color.Primary" Size="Size.Small" Class="mb-1"
                           Label="@($"Show transitive (+{pkgTransFrom.Count + pkgTransTo.Count})")" />
            }
            <MudText Typo="Typo.subtitle2">Depends on</MudText>
            @foreach (var edge in SnapshotService.GetPackageEdgesFrom(_selectedPackage.Id))
            {
                <div class="d-flex align-center gap-1 mb-1">
                    <MudChip T="string" Size="Size.Small" Color="@KindColor(edge.Kind)">@EdgeKindLabel(edge.Kind)</MudChip>
                    <MudText Typo="Typo.caption">@ShortLabel(edge.To)</MudText>
                </div>
            }
            @if (_showTransitive)
            {
                @foreach (var id in pkgTransFrom)
                {
                    <div class="d-flex align-center gap-1 mb-1" style="opacity:0.75;">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">transitive</MudChip>
                        <MudText Typo="Typo.caption">@ShortLabel(id)</MudText>
                    </div>
                }
            }
            <MudText Typo="Typo.subtitle2" Class="mt-1">Used by</MudText>
            @foreach (var edge in SnapshotService.GetPackageEdgesTo(_selectedPackage.Id))
            {
                <div class="d-flex align-center gap-1 mb-1">
                    <MudChip T="string" Size="Size.Small" Color="@KindColor(edge.Kind)">@EdgeKindLabel(edge.Kind)</MudChip>
                    <MudText Typo="Typo.caption">@ShortLabel(edge.From)</MudText>
                </div>
            }
            @if (_showTransitive)
            {
                @foreach (var id in pkgTransTo)
                {
                    <div class="d-flex align-center gap-1 mb-1" style="opacity:0.75;">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">transitive</MudChip>
                        <MudText Typo="Typo.caption">@ShortLabel(id)</MudText>
                    </div>
                }
            }
        </MudPaper>
    }
</div>

@code {
    private const string DimOpacityKey = "sdkinfo.graph.dimOpacity";
    private record ModuleEntry(string Name, int Tier);

    private CytoscapeGraph? _graph;

    private List<PackageNode> _allPackageNodes = [];
    private List<ModuleEntry> _moduleEntries = [];
    private List<CyNode> _nodes = [];
    private List<CyEdge> _edges = [];
    private HashSet<string> _activeModules = new(StringComparer.OrdinalIgnoreCase);
    private PackageNode? _selectedPackage;
    private string _clickDirection = "both";
    private bool _clickTransitive;
    private double _dimOpacity = 0.25;
    private string _layoutMode = "cose";
    private string _combineMode = "base";
    private string[] _presentEdgeKinds = [];
    private IEnumerable<string> _visibleEdgeKinds = [];
    private bool _showTransitive;

    protected override async Task OnInitializedAsync()
    {
        await SnapshotService.LoadAsync();
        _allPackageNodes = [.. SnapshotService.GetPackageNodesSortedByTier()];

        _presentEdgeKinds = [.. (SnapshotService.Snapshot?.PackageEdges ?? [])
            .Select(e => e.Kind)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(EdgeKindSortOrder)];
        _visibleEdgeKinds = [.. _presentEdgeKinds];

        _moduleEntries = _allPackageNodes
            .GroupBy(p => p.Module)
            .Select(g => new ModuleEntry(g.Key, g.Min(p => p.Tier)))
            .OrderBy(m => m.Tier).ThenBy(m => m.Name)
            .ToList();

        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", DimOpacityKey);
            _dimOpacity = double.TryParse(raw, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var v)
                ? Math.Clamp(v, 0.0, 0.5) : 0.25;

            var savedLayout = await JS.InvokeAsync<string?>("localStorage.getItem", "sdkinfo.graph.layout.packages");
            if (!string.IsNullOrEmpty(savedLayout))
                _layoutMode = savedLayout;
        }
        catch { /* JS not yet available — keep defaults */ }

        RebuildGraph();
    }

    private void RebuildGraph()
    {
        var snapshot = SnapshotService.Snapshot;
        if (snapshot is null) return;

        _nodes = _allPackageNodes
            .Select(p => new CyNode
            {
                Id = p.Id,
                Label = ShortLabel(p.Id),
                Tier = p.Tier,
                CiStatus = null,
                HasLocalDev = false,
                Group = p.Module,
                IsDangling = p.IsDangling,
            })
            .ToList();

        var allIds = _nodes.Select(n => n.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);

        _edges = snapshot.PackageEdges
            .Where(e => allIds.Contains(e.From) && allIds.Contains(e.To))
            .Select(e => new CyEdge { Source = e.From, Target = e.To, Kind = e.Kind })
            .ToList();
    }

    private async Task ToggleModule(string moduleName)
    {
        if (!_activeModules.Add(moduleName))
            _activeModules.Remove(moduleName);

        await ApplyBaseHighlight();
    }

    private async Task ApplyBaseHighlight()
    {
        if (_graph is null) return;

        var ids = _activeModules.Count == 0
            ? (IReadOnlyList<string>)[]
            : _allPackageNodes
                .Where(p => _activeModules.Contains(p.Module))
                .Select(p => p.Id)
                .ToList();

        await _graph.SetBaseHighlightAsync(ids);
    }

    private async Task OnLayoutModeChanged(string value)
    {
        _layoutMode = value;
        if (_graph is not null)
            await _graph.ApplyLayoutAsync(value);
    }

    private async Task OnCombineModeChanged(string value)
    {
        _combineMode = value;
        if (_graph is not null)
            await _graph.SetCombineModeAsync(value);
    }

    private async Task OnClickDirectionChanged(string value)
    {
        _clickDirection = value;
        if (_graph is not null)
            await _graph.SetClickModeAsync(_clickDirection, _clickTransitive);
    }

    private async Task OnClickTransitiveChanged(bool value)
    {
        _clickTransitive = value;
        if (_graph is not null)
            await _graph.SetClickModeAsync(_clickDirection, _clickTransitive);
    }

    private async Task OnDimOpacityChanged(double value)
    {
        _dimOpacity = value;
        if (_graph is not null)
            await _graph.SetDimOpacityAsync(value);
    }

    private async Task OnEdgeKindsChanged(IEnumerable<string> values)
    {
        _visibleEdgeKinds = [.. values];
        if (_graph is not null)
            await _graph.SetEdgeKindFilterAsync([.. _visibleEdgeKinds]);
    }

    private static string EdgeKindLabel(string kind) => kind switch
    {
        "impl" => "Impl",
        "project" => "Project",
        "contracts" => "Contracts",
        "dangling" => "Dangling",
        _ => kind,
    };

    private static int EdgeKindSortOrder(string kind) => kind switch
    {
        "impl" => 0,
        "project" => 1,
        "contracts" => 2,
        "dangling" => 3,
        _ => 99,
    };

    private static Color KindColor(string kind) => kind switch
    {
        "project" => Color.Success,
        "contracts" => Color.Info,
        "dangling" => Color.Error,
        _ => Color.Default,
    };

    private static string ShortLabel(string packageId)
        => packageId.StartsWith("BieberWorks.SDK.", StringComparison.OrdinalIgnoreCase)
            ? packageId["BieberWorks.SDK.".Length..]
            : packageId;

    private static string TierColor(int tier) => tier switch
    {
        0 => "#4caf50",
        1 => "#2196f3",
        2 => "#9c27b0",
        3 => "#ff9800",
        4 => "#f44336",
        _ => "#795548",
    };

    private void OnNodeClicked(string nodeId)
    {
        _selectedPackage = SnapshotService.GetPackageNode(nodeId);
        StateHasChanged();
    }

    private async Task OnBackgroundTapped()
    {
        // Only close detail panel; chips remain as base, JS restores base highlight
        _selectedPackage = null;
        StateHasChanged();
    }

    private void CloseDetail()
    {
        _selectedPackage = null;
        StateHasChanged();
    }

    private async Task ResetFilters()
    {
        _activeModules.Clear();
        _selectedPackage = null;
        _clickDirection = "both";
        _clickTransitive = false;
        _combineMode = "base";
        _visibleEdgeKinds = [.. _presentEdgeKinds];
        if (_graph is not null)
        {
            await _graph.SetBaseHighlightAsync([]);
            await _graph.ClearHighlightAsync();
            await _graph.SetClickModeAsync(_clickDirection, _clickTransitive);
            await _graph.SetCombineModeAsync(_combineMode);
            await _graph.SetEdgeKindFilterAsync(null);
        }
    }

    private async Task SaveLayout()
    {
        if (_graph is not null)
            await _graph.SaveLayoutAsync();
    }

    private async Task ResetLayout()
    {
        if (_graph is not null)
            await _graph.ResetLayoutAsync();
    }
}
