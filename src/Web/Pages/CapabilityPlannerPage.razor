@page "/planner"
@inject SnapshotService SnapshotService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Capability Planner</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Capability Planner</MudText>
<MudText Typo="Typo.body2" Class="mb-3">
    Select the capabilities your application needs. The planner computes the exact set of SDK modules
    required — including transitive <code>impl</code>-dependencies — and generates a ready-to-paste
    <code>PackageReference</code> snippet.
</MudText>

@if (!SnapshotService.IsLoaded)
{
    <MudProgressCircular Indeterminate="true" />
    return;
}

@if (SnapshotService.Snapshot is null || SnapshotService.Snapshot.Capabilities.Count == 0)
{
    <MudAlert Severity="Severity.Warning">
        No capability data in snapshot. Re-run the Scanner to generate it.
    </MudAlert>
    return;
}

@* ── Toolbar ─────────────────────────────────────────────────────────────────── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="4">
            <MudTextField T="string" Label="Search capabilities" Value="_search"
                          ValueChanged="OnSearchChanged"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" DebounceInterval="150" />
        </MudItem>
        <MudItem xs="12" sm="6" md="8" Class="d-flex align-center gap-2 flex-wrap">
            <MudText Typo="Typo.body2">
                <b>@_selectedCapabilityIds.Count</b>
                @(_selectedCapabilityIds.Count == 1 ? "capability" : "capabilities") selected
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Calculate"
                       OnClick="Compute" Disabled="@(_selectedCapabilityIds.Count == 0)">
                Plan
            </MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ClearAll">
                Clear
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ── Two-column body ──────────────────────────────────────────────────────────── *@
<MudGrid Spacing="3">

    @* Left — Capability tree *@
    <MudItem xs="12" md="7">
        <MudTreeView T="string"
                     SelectionMode="SelectionMode.MultiSelection"
                     @bind-SelectedValues="_treeSelectedValues"
                     @bind-SelectedValues:after="OnTreeSelectionChanged"
                     AutoSelectParent="true"
                     Dense="true"
                     Hover="true"
                     CheckBoxColor="Color.Primary">
            @foreach (var group in _filteredGroups)
            {
                <MudTreeViewItem T="string"
                                 Value="@($"__cat__{group.Id}")"
                                 Text="@($"{group.Label} ({group.Caps.Count})")"
                                 Expanded="@(!string.IsNullOrWhiteSpace(_search))">
                    @foreach (var cap in group.Caps)
                    {
                        var capId = cap.Id;
                        var desc = cap.Description ?? cap.Label;
                        <MudTreeViewItem T="string" Value="@capId">
                            <BodyContent>
                                <MudTooltip Text="@desc" Placement="Placement.Right">
                                    <MudText Typo="Typo.body2">@cap.Label</MudText>
                                </MudTooltip>
                            </BodyContent>
                        </MudTreeViewItem>
                    }
                </MudTreeViewItem>
            }
        </MudTreeView>
    </MudItem>

    @* Right — Result panel (sticky on desktop) *@
    <MudItem xs="12" md="5">
        <div id="planner-result" style="position:sticky; top:16px;">
            @if (_result is null)
            {
                <MudPaper Class="pa-4" Elevation="1"
                          Style="min-height:200px; display:flex; align-items:center; justify-content:center;">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                        Select capabilities and click <b>Plan</b> to see the required modules.
                    </MudText>
                </MudPaper>
            }
            else
            {
                <MudPaper Class="pa-3" Elevation="2">
                    <MudText Typo="Typo.h6" Class="mb-2">
                        Required Modules (@_result.AllModules.Count)
                    </MudText>

                    <MudList T="ModuleInfo" Dense="true" Class="mb-2">
                        @foreach (var m in _result.AllModules)
                        {
                            var isDirect = _result.DirectModuleIds.Contains(m.Id);
                            <MudListItem T="ModuleInfo" Style="padding:2px 0;">
                                <div class="d-flex align-center gap-1 flex-wrap">
                                    <MudChip T="string" Size="Size.Small"
                                             Style="@TierChipStyle(m.Tier)">
                                        T@(m.Tier)
                                    </MudChip>
                                    <MudText Typo="Typo.body2"
                                             Style="font-family:monospace; font-size:0.8rem;">
                                        @m.Id
                                    </MudText>
                                    @if (!string.IsNullOrEmpty(m.LatestGhVersion))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            v@(m.LatestGhVersion)
                                        </MudText>
                                    }
                                    @if (isDirect)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                 Size="Size.Small" Color="Color.Success"
                                                 Title="direct provider" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Link"
                                                 Size="Size.Small" Color="Color.Default"
                                                 Title="transitive impl-dependency" />
                                    }
                                </div>
                            </MudListItem>
                        }
                    </MudList>

                    <div class="d-flex gap-2 mb-2 flex-wrap">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ContentCopy"
                                   OnClick="CopyPackageReferences">
                            PackageReferences
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ContentCopy"
                                   OnClick="CopyNugetConfig">
                            nuget.config
                        </MudButton>
                    </div>

                    <MudPaper Elevation="0" Class="pa-2 mb-3"
                              Style="background:var(--mud-palette-background-grey); overflow:auto; max-height:240px;">
                        <pre style="font-size:0.72rem; white-space:pre-wrap; margin:0;">@_result.Snippet</pre>
                    </MudPaper>

                    <MudText Typo="Typo.subtitle2" Class="mb-1">Dependency Graph</MudText>
                    <CytoscapeGraph @ref="_miniGraph"
                                    Nodes="@_result.GraphNodes" Edges="@_result.GraphEdges"
                                    Height="320px" PersistKey="planner" Layout="dagre" />
                </MudPaper>
            }
        </div>
    </MudItem>

</MudGrid>

@code {
    private sealed record FilteredGroup(string Id, string Label, List<CapabilityInfo> Caps);

    // ── state ──────────────────────────────────────────────────────────────────
    private List<CapabilityGroup> _allGroups = [];
    private Dictionary<string, CapabilityInfo> _capById = [];
    private List<FilteredGroup> _filteredGroups = [];

    private IReadOnlyCollection<string> _treeSelectedValues = [];
    private HashSet<string> _selectedCapabilityIds = new(StringComparer.OrdinalIgnoreCase);

    private string _search = "";
    private PlanResult? _result;
    private CytoscapeGraph? _miniGraph;

    // ── lifecycle ──────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await SnapshotService.LoadAsync();
        var snap = SnapshotService.Snapshot;
        if (snap is null) return;

        _allGroups = snap.CapabilityGroups.OrderBy(g => g.Label).ToList();
        _capById = snap.Capabilities.ToDictionary(c => c.Id, StringComparer.OrdinalIgnoreCase);

        RebuildFilteredGroups();
    }

    // ── filtering ──────────────────────────────────────────────────────────────
    private void RebuildFilteredGroups()
    {
        var hasSearch = !string.IsNullOrWhiteSpace(_search);
        var q = _search.Trim();

        _filteredGroups = _allGroups
            .Select(group =>
            {
                var caps = group.Members
                    .Select(id => _capById.GetValueOrDefault(id))
                    .Where(cap => cap is not null)
                    .Where(cap => !hasSearch
                        || cap!.Label.Contains(q, StringComparison.OrdinalIgnoreCase)
                        || (cap!.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false))
                    .Select(cap => cap!)
                    .ToList();
                return new FilteredGroup(group.Id, group.Label, caps);
            })
            .Where(g => g.Caps.Count > 0)
            .ToList();
    }

    // ── handlers ───────────────────────────────────────────────────────────────
    private void OnTreeSelectionChanged()
    {
        _selectedCapabilityIds = _treeSelectedValues
            .Where(v => v is not null && !v.StartsWith("__cat__", StringComparison.Ordinal))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        _result = null;
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        RebuildFilteredGroups();
    }

    private void ClearAll()
    {
        _treeSelectedValues = [];
        _selectedCapabilityIds.Clear();
        _result = null;
        _search = "";
        RebuildFilteredGroups();
    }

    private async Task Compute()
    {
        var snap = SnapshotService.Snapshot;
        if (snap is null || _selectedCapabilityIds.Count == 0) return;

        var directIds = SnapshotService.DirectModulesForCapabilities(_selectedCapabilityIds);
        var allIds = SnapshotService.TransitiveUpstreamClosure(directIds);

        var moduleMap = snap.Modules.ToDictionary(m => m.Id, StringComparer.OrdinalIgnoreCase);
        var allModules = allIds
            .Select(id => moduleMap.GetValueOrDefault(id))
            .Where(m => m is not null)
            .Select(m => m!)
            .OrderBy(m => m.Tier)
            .ThenBy(m => m.Id)
            .ToList();

        var graphNodes = allModules.Select(m => new CyNode
        {
            Id = m.Id,
            Label = m.Id.Replace("SDK-", ""),
            Tier = m.Tier,
            CiStatus = m.CiStatus,
            HasLocalDev = m.LocalDevPresent,
        }).ToList();

        var graphEdges = snap.Edges
            .Where(e => allIds.Contains(e.From) && allIds.Contains(e.To))
            .Select(e => new CyEdge { Source = e.From, Target = e.To, Kind = e.Kind })
            .ToList();

        var snippet = PackageReferenceSnippetBuilder.BuildPackageReferences(allModules, directIds);

        _result = new PlanResult(directIds, allModules, graphNodes, graphEdges, snippet);
        StateHasChanged();

        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('planner-result')?.scrollIntoView({behavior:'smooth',block:'nearest'})");
        }
        catch { /* non-critical */ }

        if (_miniGraph is not null && directIds.Count > 0)
            await _miniGraph.HighlightAsync(directIds.ToList());
    }

    private async Task CopyPackageReferences()
    {
        if (_result is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _result.Snippet);
            Snackbar.Add("PackageReferences copied to clipboard.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Could not access clipboard.", Severity.Warning);
        }
    }

    private async Task CopyNugetConfig()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText",
                PackageReferenceSnippetBuilder.BuildNugetConfigLine());
            Snackbar.Add("nuget.config line copied to clipboard.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Could not access clipboard.", Severity.Warning);
        }
    }

    private static string TierChipStyle(int tier)
    {
        var bg = tier switch
        {
            0 => "#4caf50",
            1 => "#2196f3",
            2 => "#9c27b0",
            3 => "#ff9800",
            4 => "#f44336",
            _ => "#795548",
        };
        return $"background-color:{bg};color:#fff;min-width:36px;";
    }

    private sealed record PlanResult(
        HashSet<string> DirectModuleIds,
        List<ModuleInfo> AllModules,
        List<CyNode> GraphNodes,
        List<CyEdge> GraphEdges,
        string Snippet);
}
