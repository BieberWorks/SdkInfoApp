@inherits LayoutComponentBase
@inject SnapshotService Snapshot
@inject NavigationManager Nav

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">BieberWorks SDK Info</MudText>
        <MudSpacer />
        @if (Snapshot.IsLoaded && Snapshot.Snapshot is not null)
        {
            <MudChip T="string" Color="@(Snapshot.IsLocalMode ? Color.Warning : Color.Success)"
                     Size="Size.Small" Class="mr-2">
                @(Snapshot.IsLocalMode ? "Local Dev" : "Release")
            </MudChip>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
            <MudNavLink Href="/graph" Icon="@Icons.Material.Filled.AccountTree">
                Module Graph
            </MudNavLink>
            <MudNavLink Href="/modules" Icon="@Icons.Material.Filled.ViewList">
                Modules
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    protected override async Task OnInitializedAsync()
    {
        await Snapshot.LoadAsync();
        Snapshot.OnChange += StateHasChanged;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
