@inherits LayoutComponentBase
@inject SnapshotService Snapshot
@inject ThemeService ThemeService
@inject NavigationManager Nav

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">BieberWorks SDK Info</MudText>
        <MudSpacer />
        @if (Snapshot.IsLoaded && Snapshot.Snapshot is not null)
        {
            <MudMenu Icon="@Icons.Material.Filled.AccountTree" Color="Color.Inherit"
                     Class="mr-1" Dense="true" AnchorOrigin="Origin.BottomLeft">
                <ActivatorContent>
                    <MudButton Color="Color.Inherit" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                               Size="Size.Small" Class="mr-1">
                        @Snapshot.SelectedBranch
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var info in Snapshot.Branches)
                    {
                        var branchName = info.Branch;
                        <MudMenuItem OnClick="@(() => SelectBranchAsync(branchName))"
                                     Disabled="@(branchName == Snapshot.SelectedBranch)">
                            @if (branchName == Snapshot.SelectedBranch)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" />
                            }
                            @branchName
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>

            <MudChip T="string" Color="@(Snapshot.IsLocalMode ? Color.Warning : Color.Success)"
                     Size="Size.Small" Class="mr-2">
                @(Snapshot.IsLocalMode ? "Local Dev" : "Release")
            </MudChip>
        }
        <MudIconButton Color="Color.Inherit"
                       Icon="@(ThemeService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       OnClick="ToggleTheme" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
            <MudNavLink Href="/graph" Icon="@Icons.Material.Filled.AccountTree">
                Module Graph
            </MudNavLink>
            <MudNavLink Href="/packages" Icon="@Icons.Material.Filled.Hub">
                Package Graph
            </MudNavLink>
            <MudNavLink Href="/modules" Icon="@Icons.Material.Filled.ViewList">
                Modules
            </MudNavLink>
            <MudNavLink Href="/planner" Icon="@Icons.Material.Filled.ChecklistRtl">
                Capability Planner
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    protected override async Task OnInitializedAsync()
    {
        await Snapshot.LoadAsync();
        Snapshot.OnChange += StateHasChanged;
        ThemeService.Changed += StateHasChanged;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleTheme() => await ThemeService.ToggleAsync();

    private async Task SelectBranchAsync(string branch) =>
        await Snapshot.SelectBranchAsync(branch);
}
