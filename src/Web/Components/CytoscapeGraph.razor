@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@_wrapperId" style="position:relative; width:100%; height:@Height;">
    <div id="@_elementId" style="width:100%; height:100%; border:1px solid var(--mud-palette-lines-default); border-radius:4px;"></div>
    @if (ShowControls)
    {
        <MudPaper Elevation="2"
                  Style="position:absolute; bottom:12px; right:12px; z-index:10; display:flex; flex-direction:column; gap:2px; padding:2px; opacity:0.9;">
            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Title="Zoom in" OnClick="ZoomInAsync" />
            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Title="Zoom out" OnClick="ZoomOutAsync" />
            <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong" Size="Size.Small" Title="Fit to view" OnClick="FitAsync" />
            <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Size="Size.Small" Title="Fullscreen" OnClick="ToggleFullscreenAsync" />
        </MudPaper>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<CyNode> Nodes { get; set; } = [];
    [Parameter] public IReadOnlyList<CyEdge> Edges { get; set; } = [];
    [Parameter] public string Height { get; set; } = "600px";
    [Parameter] public string PersistKey { get; set; } = "default";
    [Parameter] public string Layout { get; set; } = "dagre";
    [Parameter] public bool ShowControls { get; set; } = true;
    [Parameter] public EventCallback<string> OnNodeClicked { get; set; }
    [Parameter] public EventCallback OnBackgroundTapped { get; set; }

    private readonly string _wrapperId = $"cyw-{Guid.NewGuid():N}";
    private readonly string _elementId = $"cy-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<CytoscapeGraph>? _dotNetRef;
    private bool _initialized;
    private string _lastDataSignature = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./lib/graph-interop.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initGraph", _elementId, _dotNetRef, PersistKey, Layout);
            _initialized = true;
        }

        if (_initialized && _module is not null)
        {
            var sig = ComputeSignature(Nodes, Edges);
            if (sig != _lastDataSignature)
            {
                _lastDataSignature = sig;
                await _module.InvokeVoidAsync("setData", _elementId, Nodes, Edges);
            }
        }
    }

    public async Task HighlightAsync(IReadOnlyList<string> ids)
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("highlightNodes", _elementId, ids);
    }

    public async Task ClearHighlightAsync()
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("resetHighlight", _elementId);
    }

    public async Task ResetLayoutAsync()
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("resetLayout", _elementId);
    }

    public async Task SetClickModeAsync(string direction, bool transitive)
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("setClickMode", _elementId, direction, transitive);
    }

    public async Task SetDimOpacityAsync(double value)
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("setDimOpacity", _elementId, value);
    }

    public async Task ApplyLayoutAsync(string mode)
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("applyLayout", _elementId, mode);
    }

    public async Task SetBaseHighlightAsync(IReadOnlyList<string> ids)
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("setBaseHighlight", _elementId, ids);
    }

    public async Task SetCombineModeAsync(string mode)
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("setCombineMode", _elementId, mode);
    }

    public async Task FitAsync()
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("fitGraph", _elementId);
    }

    public async Task ZoomInAsync()
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("zoomByFactor", _elementId, 1.25);
    }

    public async Task ZoomOutAsync()
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("zoomByFactor", _elementId, 0.8);
    }

    public async Task ToggleFullscreenAsync()
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("toggleFullscreen", _wrapperId);
    }

    public async Task ExportPngAsync(string filename)
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("exportPng", _elementId, filename);
    }

    public async Task SaveLayoutAsync()
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("saveLayout", _elementId);
    }

    public async Task<string?> GetPersistedLayoutAsync()
    {
        if (_initialized && _module is not null)
            return await _module.InvokeAsync<string?>("getPersistedLayout", PersistKey);
        return null;
    }

    [JSInvokable]
    public Task NodeClickedAsync(string nodeId) => OnNodeClicked.InvokeAsync(nodeId);

    [JSInvokable]
    public Task BackgroundTappedAsync() => OnBackgroundTapped.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_module is not null) await _module.DisposeAsync();
    }

    private static string ComputeSignature(IReadOnlyList<CyNode> nodes, IReadOnlyList<CyEdge> edges)
    {
        var nodesPart = string.Join(",", nodes.Select(n => n.Id));
        var edgesPart = string.Join(",", edges.Select(e => $"{e.Source}->{e.Target}"));
        return $"{nodesPart}|{edgesPart}";
    }
}
