@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@_elementId" style="width: 100%; height: @Height; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;"></div>

@code {
    [Parameter] public IReadOnlyList<CyNode> Nodes { get; set; } = [];
    [Parameter] public IReadOnlyList<CyEdge> Edges { get; set; } = [];
    [Parameter] public string Height { get; set; } = "600px";
    [Parameter] public string PersistKey { get; set; } = "default";
    [Parameter] public string Layout { get; set; } = "dagre";
    [Parameter] public EventCallback<string> OnNodeClicked { get; set; }
    [Parameter] public EventCallback OnBackgroundTapped { get; set; }

    private readonly string _elementId = $"cy-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<CytoscapeGraph>? _dotNetRef;
    private bool _initialized;
    private string _lastDataSignature = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./lib/graph-interop.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initGraph", _elementId, _dotNetRef, PersistKey, Layout);
            _initialized = true;
        }

        if (_initialized && _module is not null)
        {
            var sig = ComputeSignature(Nodes, Edges);
            if (sig != _lastDataSignature)
            {
                _lastDataSignature = sig;
                await _module.InvokeVoidAsync("setData", _elementId, Nodes, Edges);
            }
        }
    }

    public async Task HighlightAsync(IReadOnlyList<string> ids)
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("highlightNodes", _elementId, ids);
    }

    public async Task ClearHighlightAsync()
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("resetHighlight", _elementId);
    }

    public async Task ResetLayoutAsync()
    {
        if (_initialized && _module is not null)
            await _module.InvokeVoidAsync("resetLayout", _elementId);
    }

    [JSInvokable]
    public Task NodeClickedAsync(string nodeId) => OnNodeClicked.InvokeAsync(nodeId);

    [JSInvokable]
    public Task BackgroundTappedAsync() => OnBackgroundTapped.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_module is not null) await _module.DisposeAsync();
    }

    private static string ComputeSignature(IReadOnlyList<CyNode> nodes, IReadOnlyList<CyEdge> edges)
    {
        var nodesPart = string.Join(",", nodes.Select(n => n.Id));
        var edgesPart = string.Join(",", edges.Select(e => $"{e.Source}->{e.Target}"));
        return $"{nodesPart}|{edgesPart}";
    }
}
