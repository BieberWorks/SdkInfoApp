<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <!-- CS8669: Razor source-generator emits nullable annotations without #nullable context for T="int?" etc. -->
    <NoWarn>$(NoWarn);CS8669;MUD0002</NoWarn>
    <RootNamespace>SdkInfoApp.Web</RootNamespace>
    <AssemblyName>SdkInfoApp.Web</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GHPages)' == 'true'">
    <WasmBaseHref>/SdkInfoApp/</WasmBaseHref>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scanner.Model\Scanner.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="MudBlazor" Version="9.5.0" />
  </ItemGroup>

</Project>
